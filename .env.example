# Copy to .env.local (gitignored) for local development, and fill in real
# values from your Supabase project: Project Settings -> API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key -- safe to expose
# client-side, access is enforced by Row Level Security, not secrecy.
# Never put the "service_role" key in this file or anywhere in app code.
#
# For production (Cloudflare Pages), set these same two variables in the
# Cloudflare dashboard: Settings -> Environment variables. Nothing about
# production config is committed to this repo -- it's public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
