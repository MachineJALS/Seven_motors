# Committed on purpose (unlike .env.local): Vite auto-loads this during
# `npm run build`, which is what Cloudflare runs to deploy. Only the public
# Supabase URL and "anon" key go here — both are safe to expose client-side
# (access is enforced by Row Level Security, not by keeping the key
# secret). Never put the "service_role" key in this file.
#
# This exists as a workaround for a Cloudflare platform limitation: when a
# project is created as a Worker with only static assets (no server-side
# Worker code, which is what this Vite SPA is), Cloudflare currently blocks
# adding environment variables to it in the dashboard ("Variables cannot be
# added to a Worker that only has static assets"). Committing the build-time
# values here sidesteps that entirely — Vite bakes them into the built JS
# during `npm run build`, so Cloudflare's dashboard config isn't needed.
VITE_SUPABASE_URL=https://oluqpjqagunyqwevldfg.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9sdXFwanFhZ3VueXF3ZXZsZGZnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MzY0NDQsImV4cCI6MjEwMjMxMjQ0NH0.fZI6H-aQFOW8lZhhnGnL72zRFVF3Vls1urqkhn-Zxss
